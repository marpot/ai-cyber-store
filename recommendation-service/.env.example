# Recommendation service environment variables
# Copy to `.env` and adjust for your environment.

# Base URL of the WordPress + WooCommerce REST API (used to enrich responses
# with real product data instead of hardcoded placeholders).
WORDPRESS_API_URL=http://localhost:8080

# WooCommerce REST API credentials (optional — only needed for authenticated
# endpoints like stock checks).
WORDPRESS_CONSUMER_KEY=
WORDPRESS_CONSUMER_SECRET=

# Confidence threshold (0.0-1.0). Below this the bot returns default guidance
# instead of intent-based products.
RECOMMENDATION_CONFIDENCE_THRESHOLD=0.45

# OpenAI fallback (optional). Leave empty to disable LLM fallback entirely.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# CORS — comma-separated list of allowed origins. Use "*" only in development.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8080