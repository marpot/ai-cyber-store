# Frontend environment variables (Vite)
# Copy to `.env` and adjust for your environment.

# Base URL of the WordPress + WooCommerce REST API.
# Inside docker-compose the hostname is `wordpress`, outside it's `localhost`.
VITE_WP_API_URL=http://localhost:8080

# Base URL of the AI recommendation service.
VITE_RECOMMENDATION_API_URL=http://localhost:8000

# Optional legacy WooCommerce REST API credentials. The browser Store API
# cart and native checkout flow do not require them.
VITE_WC_CONSUMER_KEY=
VITE_WC_CONSUMER_SECRET=
