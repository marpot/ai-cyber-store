# =============================================================================
# AI Cyber Store — root environment variables
# =============================================================================
# Copy this file to `.env` and fill in real values.
# Real `.env` is git-ignored. Never commit secrets.

# -----------------------------------------------------------------------------
# WordPress + MySQL (used by docker-compose.yml)
# -----------------------------------------------------------------------------
WORDPRESS_DB_HOST=mysql
WORDPRESS_DB_USER=wp_user
WORDPRESS_DB_PASSWORD=wp_password
WORDPRESS_DB_NAME=wordpress

MYSQL_DATABASE=wordpress
MYSQL_USER=wp_user
MYSQL_PASSWORD=wp_password
MYSQL_ROOT_PASSWORD=root_password

# -----------------------------------------------------------------------------
# PostgreSQL (used by recommendation-service)
# -----------------------------------------------------------------------------
POSTGRES_DB=cyber_ai
POSTGRES_USER=ai_admin
POSTGRES_PASSWORD=ai_password

# -----------------------------------------------------------------------------
# WordPress REST API — WooCommerce consumer key/secret
# Generate in WP admin: WooCommerce -> Settings -> Advanced -> REST API
# -----------------------------------------------------------------------------
WORDPRESS_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WORDPRESS_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL of WordPress (no trailing slash). Used by frontend & recommendation service.
WORDPRESS_API_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Recommendation service
# -----------------------------------------------------------------------------
RECOMMENDATION_SERVICE_URL=http://localhost:8000

# Confidence threshold (0.0-1.0). Below this, the bot returns the default guidance
# instead of intent-based products.
RECOMMENDATION_CONFIDENCE_THRESHOLD=0.45

# Optional: OpenAI-compatible LLM fallback (OpenRouter free models, local Ollama,
# llama.cpp server, etc.). Leave LLM_API_KEY empty to disable — the service then
# runs entirely on the local intent classifier + fuzzy matcher.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free

# -----------------------------------------------------------------------------
# Frontend (Vite — only VITE_-prefixed vars are exposed to the browser)
# -----------------------------------------------------------------------------
VITE_WP_API_URL=http://localhost:8080
VITE_RECOMMENDATION_API_URL=http://localhost:8000